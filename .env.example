# ── LLM (lesson scripting + Arabic translation) ────────────────────────────
# Primary. Free tier is enough for 5 lessons/day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Fallback 1 (free, very fast)
# Order can be changed with LLM_ORDER=groq,gemini,openrouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fallback 2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free

# ── Visuals ────────────────────────────────────────────────────────────────
# Stock footage for listening/speaking backgrounds
PEXELS_API_KEY=
PIXABAY_API_KEY=
# AI images: "pollinations" (free, no key) | "huggingface" | "off"
IMAGE_PROVIDER=pollinations
HUGGINGFACE_API_KEY=

# ── YouTube upload ─────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public

# ── Behaviour ──────────────────────────────────────────────────────────────
# Set to 1 to build videos without uploading (local testing)
DRY_RUN=0
